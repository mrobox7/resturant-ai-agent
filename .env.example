# --- OpenAI ---
# LLM_API_KEY=your_openai_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

MAX_TOOL_ITERATIONS=5
MAX_RETRIES=3
