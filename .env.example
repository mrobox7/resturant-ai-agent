# Groq. Key from https://console.groq.com/keys

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

MAX_RETRIES=3

# Restaurant Reservation API (the provided backend, run separately)
BACKEND_API_BASE_URL=http://localhost:8000
BACKEND_API_TIMEOUT=5.0

# Optional: unset means observability is silently skipped.
# LOGFIRE_TOKEN=

# Anything else you keep in .env is ignored by Settings rather than rejected.
