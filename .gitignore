# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Runtime-generated per-customer episodic memory (see app/memory.py)
/memory/

# Secrets. The glob also covers .env.bak, .env.local and friends — a
# bare `.env` line does not, and those hold real keys too.
.env
.env.*
!.env.example
